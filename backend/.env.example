# نمونهٔ تنظیمات؛ این فایل را به .env کپی کنید.
# رمز مدیر فقط همین‌جا (و نه داخل کد یا گیت) نگه داشته می‌شود.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=یک-رمز-قوی-بگذارید

# در استقرار واقعی روی HTTPS این را production بگذارید
SHOP_ENV=development

# کلید امضای نشست (پیشنهادی برای تولید):
# SECRET_KEY=یک-رشتهٔ-تصادفی-بلند

# مسیر دیتابیس و داده‌ها (اختیاری)
# SHOP_DB_PATH=/var/lib/codelaine/shop.db
